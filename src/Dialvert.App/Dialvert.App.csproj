<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WinForms analyzer; DPI awareness is set in app.manifest for WPF. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>Dialvert</AssemblyName>
    <RootNamespace>Dialvert.App</RootNamespace>
    <ApplicationIcon>Assets\dialvert.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>Dialvert</Product>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WinForms/Drawing out of the global usings so WPF types stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\dialvert.ico" />
    <None Remove="Assets\dialvert-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dialvert.Core\Dialvert.Core.csproj" />
  </ItemGroup>

</Project>
