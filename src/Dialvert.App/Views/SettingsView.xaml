<UserControl x:Class="Dialvert.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Dialvert.App.Views">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource StrokeHi}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
            <Setter Property="Margin" Value="0,30,0,6"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,10,0,10"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="90"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,28,24" MaxWidth="720" HorizontalAlignment="Stretch">

                <Border Style="{StaticResource Section}" Margin="0,22,0,6">
                    <TextBlock Text="WHEEL" Style="{StaticResource Label}" Foreground="{StaticResource TextDim}"/>
                </Border>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Open the wheel" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Hold this key and right-click a file in Explorer or on the desktop." Style="{StaticResource RowNote}"/>
                    </StackPanel>
                    <v:KeyCaptureBox x:Name="TriggerKey" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Switch mode" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Press a key while the wheel is open." Style="{StaticResource RowNote}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Convert" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <v:KeyCaptureBox x:Name="ConvertKey" HorizontalAlignment="Right" Margin="110,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Compress" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <v:KeyCaptureBox x:Name="CompressKey" HorizontalAlignment="Right" Margin="110,0,0,0"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Tools" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <v:KeyCaptureBox x:Name="ToolsKey" HorizontalAlignment="Right" Margin="110,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Wheel opens with" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton x:Name="StartConvert" Style="{StaticResource SegmentChoice}" Content="Convert" GroupName="start"/>
                        <RadioButton x:Name="StartCompress" Style="{StaticResource SegmentChoice}" Content="Compress" GroupName="start"/>
                        <RadioButton x:Name="StartTools" Style="{StaticResource SegmentChoice}" Content="Tools" GroupName="start"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Section}">
                    <TextBlock Text="OUTPUT" Style="{StaticResource Label}" Foreground="{StaticResource TextDim}"/>
                </Border>
                <Grid Style="{StaticResource Row}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
                        <TextBlock Text="Output folder" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Empty = next to the source file. Existing files are never overwritten." Style="{StaticResource RowNote}"/>
                    </StackPanel>
                    <TextBox x:Name="OutputFolder" Grid.Row="1"/>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Btn}" Content="Browse …" Margin="8,0,0,0" Click="BrowseOutput_Click"/>
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Btn}" Content="Clear" Margin="8,0,0,0" Click="ClearOutput_Click"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Target size, images (KB)" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                    <TextBox x:Name="ImageTarget" Grid.Column="1" Style="{StaticResource NumberBox}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Target size, video / audio (MB)" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                    <TextBox x:Name="VideoTarget" Grid.Column="1" Style="{StaticResource NumberBox}"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Image quality when converting (1–100)" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                    <TextBox x:Name="Quality" Grid.Column="1" Style="{StaticResource NumberBox}"/>
                </Grid>
                <CheckBox x:Name="StripMeta" Margin="0,10">
                    <StackPanel>
                        <TextBlock Text="Remove metadata" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Drop EXIF and GPS data when compressing." Style="{StaticResource RowNote}"/>
                    </StackPanel>
                </CheckBox>

                <Border Style="{StaticResource Section}">
                    <TextBlock Text="ENGINES" Style="{StaticResource Label}" Foreground="{StaticResource TextDim}"/>
                </Border>
                <CheckBox x:Name="Hardware" Margin="0,10">
                    <StackPanel>
                        <TextBlock Text="Use the graphics card for video encoding" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="NVENC, Quick Sync or AMF, if available." Style="{StaticResource RowNote}"/>
                    </StackPanel>
                </CheckBox>
                <Grid Style="{StaticResource Row}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
                        <TextBlock Text="FFmpeg path" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Empty = bundled version, then PATH." Style="{StaticResource RowNote}"/>
                    </StackPanel>
                    <TextBox x:Name="FfmpegPath" Grid.Row="1"/>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Btn}" Content="Browse …" Margin="8,0,0,0" Click="BrowseFfmpeg_Click"/>
                </Grid>
                <TextBlock x:Name="EngineInfo" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"/>

                <Border Style="{StaticResource Section}">
                    <TextBlock Text="SYSTEM" Style="{StaticResource Label}" Foreground="{StaticResource TextDim}"/>
                </Border>
                <CheckBox x:Name="Autostart" Margin="0,10">
                    <StackPanel>
                        <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Runs hidden in the notification area so the wheel is ready right away." Style="{StaticResource RowNote}"/>
                    </StackPanel>
                </CheckBox>
                <CheckBox x:Name="ShowDrop" Margin="0,10">
                    <StackPanel>
                        <TextBlock Text="Show drop zone on startup" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Small floating target to drag files onto. Optional – the wheel works without it." Style="{StaticResource RowNote}"/>
                    </StackPanel>
                </CheckBox>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Show/hide drop zone" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="Global shortcut, works in any app." Style="{StaticResource RowNote}"/>
                    </StackPanel>
                    <v:KeyCaptureBox x:Name="ToggleKey" Grid.Column="1" RequireModifier="True" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="Paths" Style="{StaticResource MonoText}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,20,0"/>
                    <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Open folder" VerticalAlignment="Top" Click="OpenData_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="28,10">
            <Grid>
                <TextBlock x:Name="Error" Foreground="{StaticResource Danger}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,200,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn}" Content="Discard" Margin="0,0,8,0" Click="Revert_Click"/>
                    <Button Style="{StaticResource PrimaryBtn}" Content="Save" Padding="18,6" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
