<Window x:Class="Dialvert.App.Views.WheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialvert" Width="480" Height="480" Style="{StaticResource AppWindow}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        AllowDrop="True" Focusable="True">
    <Canvas x:Name="Root" Width="480" Height="480" RenderTransformOrigin="0.5,0.5">
        <Canvas.RenderTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
        </Canvas.RenderTransform>
        <!-- Nearly invisible halo: layered windows let fully transparent pixels fall through,
             so this keeps a stray release near the wheel from landing on whatever is behind it. -->
        <Ellipse Canvas.Left="6" Canvas.Top="6" Width="468" Height="468" Fill="#02000000"/>
        <!-- Dial ticks around the ring; the one at the hovered segment lights up. -->
        <Canvas x:Name="Ticks"/>
        <Canvas x:Name="Ring"/>
        <Ellipse x:Name="Hub" Width="160" Height="160" Canvas.Left="160" Canvas.Top="160"
                 Fill="{StaticResource Ink}" Stroke="{StaticResource StrokeHi}" StrokeThickness="1"/>
        <StackPanel x:Name="HubContent" Canvas.Left="160" Canvas.Top="186" Width="160">
            <TextBlock x:Name="FileSummary" Text="1 file" Style="{StaticResource MonoText}" FontSize="10.5" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="96" Margin="0,0,0,7"/>
            <StackPanel x:Name="ModeList" HorizontalAlignment="Center"/>
        </StackPanel>
        <Grid Canvas.Top="452" Width="480">
            <Border HorizontalAlignment="Center" Background="{StaticResource Ink}" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1" CornerRadius="3" Padding="9,3,9,4">
                <TextBlock x:Name="Hint" Style="{StaticResource Dim}" FontSize="11"/>
            </Border>
        </Grid>
    </Canvas>
</Window>
